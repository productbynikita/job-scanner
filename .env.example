# Copy this file to `.env` and fill in your tokens.
# .env is gitignored — never commit it.

# Apify API token (used by LinkedIn collector and enrich command).
# Get yours at https://console.apify.com/account/integrations
# Required for: scan:linkedin, enrich
APIFY_TOKEN=

# Optional: cap your monthly Apify spend (USD). If your usage approaches this,
# the scanner refuses to make new paid calls until next month. Default: 5.
APIFY_MONTHLY_BUDGET_USD=5

# Anthropic API key (used by assess, tailor-cv, cover commands).
# Get yours at https://console.anthropic.com/settings/keys
# Required for: assess, tailor-cv, cover
ANTHROPIC_API_KEY=

# Optional: log level (trace|debug|info|warn|error|silent). Default: info.
# LOG_LEVEL=info

# Optional: log format (pretty|json). Default: pretty.
# LOG_FORMAT=pretty
